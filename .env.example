NEXT_APP_BASE_URL=""
NEXT_PUBLIC_DOMAIN="

# --- Maps --------------------------------------------------------------------
# MapTiler renders OpenStreetMap data with much clearer cartography than the
# raw OSM tiles. Unset falls back to tile.openstreetmap.org, so this is
# optional — but the fallback has heavier labels and a stricter usage policy.
#
# This key reaches the browser (it is the browser that loads tiles), so it MUST
# be domain-restricted in the MapTiler dashboard or anyone can spend your quota.
NEXT_PUBLIC_MAPTILER_KEY=
# streets-v2 (default), basic-v2, bright-v2, topo-v2, openstreetmap…
NEXT_PUBLIC_MAPTILER_STYLE=streets-v2
